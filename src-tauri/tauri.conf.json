{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pisper",
  "version": "desktop-package.json",
  "identifier": "com.lingkongran.pisper",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "capabilities": ["desktop-runtime", "desktop-terminal"],
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/pisper-sidecar", "binaries/pisper-cli"],
    "resources": {
      "../dist/": "desktop/dist/",
      "../release/sea/runtime/": "sidecar-runtime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
