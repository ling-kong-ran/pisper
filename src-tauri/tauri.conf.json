{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pisper",
  "version": "desktop-package.json",
  "identifier": "com.lingkongran.pisper",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "capabilities": [
        "desktop-runtime",
        "desktop-terminal",
        "desktop-remote",
        "desktop-browser",
        "desktop-computer",
        "desktop-shell-installer",
        "mobile-bridge"
      ],
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwRTUzMkExNjAyRUNGQTQKUldTa3p5NWdvVExsOEQ5TElOa3BVcUxZQ2I1RlNieHJHeFQ3YVdqeTRMK0VKS2dWSlZsMXRNazQK",
      "endpoints": ["https://github.com/ling-kong-ran/pisper/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/pisper-sidecar", "binaries/pisper-cli"],
    "resources": {
      "../dist/": "desktop/dist/",
      "../release/sea/runtime/": "sidecar-runtime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.macos.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese"],
        "installerHooks": "installer/prerequisites.nsh",
        "customLanguageFiles": {
          "English": "installer/English.nsh",
          "SimpChinese": "installer/SimpChinese.nsh"
        }
      }
    }
  }
}
