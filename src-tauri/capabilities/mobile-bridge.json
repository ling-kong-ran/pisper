{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "mobile-bridge",
  "description": "Mobile bridge: pairing page (app origin) and proxied UI (remote origin) can manage servers and post notifications.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*/*"]
  },
  "permissions": [
    "core:default",
    "allow-pisper-mobile-bridge",
    "barcode-scanner:allow-scan",
    "barcode-scanner:allow-cancel",
    "barcode-scanner:allow-check-permissions",
    "barcode-scanner:allow-request-permissions",
    "dns-sd:default",
    "notification:default"
  ]
}
