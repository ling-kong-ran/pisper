{
  "name": "vesper",
  "private": true,
  "version": "0.2.10",
  "description": "A local-first multi-agent workspace for parallel sessions, tools, memory, and workflows.",
  "author": {
    "name": "ling-kong-ran",
    "email": "65328093+ling-kong-ran@users.noreply.github.com",
    "url": "https://github.com/ling-kong-ran"
  },
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "vite build",
    "icons": "node scripts/generate-icons.mjs",
    "desktop:dev": "npm run icons && npm run build && electron .",
    "desktop:pack": "npm run icons && npm run build && electron-builder --publish never",
    "release": "node scripts/release.mjs",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "node scripts/check-i18n.mjs",
    "check": "npm run typecheck && npm run lint && npm run i18n:check && npm run format:check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "tsx --test server/tests/*.test.mjs",
    "preview": "node server/index.mjs --production",
    "start": "node server/index.mjs --production"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.67",
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "electron-updater": "^6.8.9",
    "officeparser": "^7.3.0",
    "openai": "^6.26.0",
    "playwright-core": "^1.61.1",
    "qrcode": "^1.5.4",
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@radix-ui/react-use-controllable-state": "^1.2.5",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@xyflow/react": "^12.11.2",
    "ai": "^7.0.37",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dockview-react": "^7.0.4",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "embla-carousel-react": "^8.6.0",
    "i18next": "^26.3.6",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "nanoid": "^6.0.0",
    "next-themes": "^0.4.6",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.6",
    "radix-ui": "^1.6.5",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.10",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.8.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "remend": "^1.3.0",
    "shadcn": "^4.14.1",
    "sharp": "^0.35.3",
    "shiki": "^4.3.1",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tokenlens": "^1.3.1",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "use-stick-to-bottom": "^1.1.6",
    "vaul": "^1.1.2",
    "vite": "^8.1.1",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "shiki": "$shiki"
  },
  "build": {
    "appId": "com.lingkongran.vesper",
    "productName": "Vesper",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "node_modules/@anthropic-ai/sandbox-runtime/vendor/**/*"
    ],
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "build/icon.png",
      "build/icons/**/*",
      "electron/**/*",
      "server/**/*",
      "shared/**/*",
      "package.json",
      "!server/tests/**/*",
      "!**/node_modules/**/{README,README.md,readme,readme.md,CHANGELOG,CHANGELOG.md,LICENSE,LICENSE.md,*.map}",
      "!**/node_modules/**/{test,tests,__tests__,docs,example,examples,.github}/**",
      "!**/node_modules/@earendil-works/pi-coding-agent/docs/**",
      "!**/node_modules/@earendil-works/pi-coding-agent/examples/**",
      "!**/node_modules/@earendil-works/pi-coding-agent/CHANGELOG.md",
      "!**/node_modules/@earendil-works/pi-coding-agent/containerization.md"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vesper"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icons",
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ling-kong-ran",
        "repo": "vesper",
        "releaseType": "release"
      }
    ]
  }
}
