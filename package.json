{
  "name": "pisper",
  "private": true,
  "version": "0.4.10",
  "license": "MIT",
  "description": "A local-first multi-agent workspace for parallel sessions, tools, memory, and workflows.",
  "author": {
    "name": "ling-kong-ran",
    "email": "65328093+ling-kong-ran@users.noreply.github.com",
    "url": "https://github.com/ling-kong-ran"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "vite build",
    "sidecar:dev": "node server/sidecar.mjs",
    "sidecar:sea": "node scripts/build-sea.mjs",
    "sidecar:sea:smoke": "node scripts/smoke-sea.mjs",
    "desktop:webview:dev": "npm run build && tauri dev",
    "desktop:webview:smoke": "node scripts/smoke-tauri-dev.mjs",
    "desktop:webview:package": "node scripts/package-tauri-release.mjs",
    "desktop:webview:build": "npm run sidecar:sea && npm run sidecar:sea:smoke && npm run tui:stage && npm run desktop:webview:package",
    "tui:dev": "cargo run --manifest-path src-tui/Cargo.toml --",
    "tui:check": "cargo check --manifest-path src-tui/Cargo.toml",
    "tui:test": "cargo test --manifest-path src-tui/Cargo.toml",
    "tui:stage": "node scripts/stage-tauri-cli.mjs",
    "tui:package": "node scripts/package-tui.mjs",
    "tui:build": "npm run sidecar:sea && npm run tui:package",
    "version": "node scripts/sync-tui-version.mjs",
    "release": "node scripts/release.mjs",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "node scripts/check-i18n.mjs",
    "check": "npm run typecheck && npm run lint && npm run i18n:check && npm run format:check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "tsx --test server/tests/*.test.mjs",
    "preview": "node server/index.mjs --production",
    "start": "node server/index.mjs --production"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "officeparser": "^7.3.0",
    "openai": "^6.26.0",
    "playwright-core": "^1.61.1",
    "qrcode": "^1.5.4",
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@radix-ui/react-use-controllable-state": "^1.2.5",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@xyflow/react": "^12.11.2",
    "ai": "^7.0.37",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dockview-react": "^7.0.4",
    "embla-carousel-react": "^8.6.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "nanoid": "^6.0.0",
    "oxlint": "^1.71.0",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.9.6",
    "radix-ui": "^1.6.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.10",
    "react-resizable-panels": "^4.12.2",
    "react-router-dom": "^7.18.1",
    "shadcn": "^4.14.1",
    "shiki": "^4.3.1",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tokenlens": "^1.3.1",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "use-stick-to-bottom": "^1.1.6",
    "vite": "^8.1.1",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "shiki": "$shiki"
  }
}
