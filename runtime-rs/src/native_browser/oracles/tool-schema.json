{
  "type": "object",
  "required": [
    "action"
  ],
  "properties": {
    "action": {
      "anyOf": [
        {
          "type": "string",
          "const": "open"
        },
        {
          "type": "string",
          "const": "inspect"
        },
        {
          "type": "string",
          "const": "click"
        },
        {
          "type": "string",
          "const": "type"
        },
        {
          "type": "string",
          "const": "wait"
        },
        {
          "type": "string",
          "const": "screenshot"
        },
        {
          "type": "string",
          "const": "close"
        }
      ]
    },
    "url": {
      "type": "string",
      "maxLength": 2000,
      "description": "HTTP/HTTPS URL for open"
    },
    "selector": {
      "type": "string",
      "maxLength": 500,
      "description": "CSS or Playwright selector for click/type"
    },
    "text": {
      "type": "string",
      "maxLength": 5000,
      "description": "Text for type"
    },
    "submit": {
      "type": "boolean",
      "description": "Press Enter after typing"
    },
    "waitMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15000
    },
    "outputName": {
      "type": "string",
      "maxLength": 120,
      "description": "PNG filename for screenshot"
    },
    "fullPage": {
      "type": "boolean",
      "description": "Capture the full scrollable page when supported"
    },
    "width": {
      "type": "integer",
      "minimum": 640,
      "maximum": 2560
    },
    "height": {
      "type": "integer",
      "minimum": 480,
      "maximum": 1600
    }
  }
}
