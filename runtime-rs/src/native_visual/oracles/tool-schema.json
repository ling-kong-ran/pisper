{
  "type": "object",
  "required": [
    "kind",
    "prompt"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "description": "image or video"
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "description": "Visual generation prompt"
    },
    "model": {
      "type": "string",
      "description": "provider/model; empty for auto"
    },
    "sourceImages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 8,
      "description": "Local image paths to edit"
    },
    "maskPath": {
      "type": "string",
      "minLength": 1,
      "description": "Optional PNG mask path"
    },
    "outputName": {
      "type": "string",
      "description": "Output name without extension"
    },
    "aspectRatio": {
      "type": "string",
      "enum": [
        "1:1",
        "16:9",
        "9:16",
        "4:3",
        "3:4"
      ]
    },
    "size": {
      "type": "string",
      "enum": [
        "1024x1024",
        "1536x1024",
        "1024x1536",
        "1280x720",
        "720x1280",
        "1792x1024",
        "1024x1792"
      ]
    },
    "imageSize": {
      "type": "string",
      "enum": [
        "1K",
        "2K",
        "4K"
      ]
    },
    "resolution": {
      "type": "string",
      "enum": [
        "720p",
        "1080p",
        "4k"
      ]
    },
    "durationSeconds": {
      "type": "number",
      "enum": [
        4,
        8,
        12
      ]
    },
    "quality": {
      "type": "string",
      "enum": [
        "auto",
        "low",
        "medium",
        "high",
        "standard",
        "hd"
      ]
    },
    "outputFormat": {
      "type": "string",
      "enum": [
        "png",
        "jpeg",
        "webp"
      ]
    }
  }
}
