{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "files": [
    "shared/browser-preferences.mjs",
    "shared/app-update.mjs",
    "shared/image/raster-image.mjs",
    "shared/game/sprite-engine-catalog.mjs",
    "shared/workflow/workflow-inputs.mjs",
    "shared/workflow/workflow-image-nodes.mjs",
    "shared/image/image-operations.mjs",
    "shared/image/image-frame-edits.mjs",
    "shared/image/image-alpha-strokes.mjs",
    "shared/game/game-assets.mjs"
  ]
}
